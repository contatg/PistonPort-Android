+    if (touch.l2 > d->l2) d->l2 = touch.l2;
+    if (touch.r2 > d->r2) d->r2 = touch.r2;
+    if (d->l2 > 30) d->buttons |= BTN_L2;
+    if (d->r2 > 30) d->buttons |= BTN_R2;
