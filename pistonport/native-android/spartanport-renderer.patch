+JNIEXPORT void JNICALL
+Java_org_pistonport_nativeandroid_GameActivity_updateTouch(JNIEnv *env, jobject activity,
+    jint buttons, jint lx, jint ly, jint rx, jint ry, jboolean left, jboolean right, jint l2, jint r2) {
+    (void)env;
