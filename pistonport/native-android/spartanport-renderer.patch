diff --git a/src/android_vulkan.c b/src/android_vulkan.c
new file mode 100644
index 0000000..3287dea
--- /dev/null
+++ b/src/android_vulkan.c
@@ -0,0 +1,163 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "gpu/shim/android_vulkan.h"
+
+#include <adrenotools/driver.h>
+#include <dlfcn.h>
+#include <jni.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static pthread_once_t loader_once = PTHREAD_ONCE_INIT;
+static PFN_vkGetInstanceProcAddr loader;
+
+static atomic_ullong presented_frames;
+
+void piston_frame_presented(bool real) {
+    // High 32 bits count real frames. Low 32 bits count all frames.
+    atomic_fetch_add_explicit(&presented_frames, real ? (1ULL << 32) + 1 : 1,
+                              memory_order_relaxed);
+}
+
+JNIEXPORT jlong JNICALL
+Java_org_pistonport_nativeandroid_PerformanceHud_presentedFrames(JNIEnv *env, jobject hud) {
+    (void)env;
+    (void)hud;
+    return atomic_load_explicit(&presented_frames, memory_order_relaxed);
+}
+
+static void init_loader(void) {
+    const char *directory = getenv("PISTON_TURNIP_DIR");
+    void *handle;
+    if (directory && directory[0]) {
+        const char *hooks = getenv("PISTON_DRIVER_HOOKS");
+        handle = hooks ? adrenotools_open_libvulkan(RTLD_NOW, ADRENOTOOLS_DRIVER_CUSTOM,
+            NULL, hooks, directory, "libpiston_turnip.so", NULL, NULL) : NULL;
+        if (!handle) {
+            fputs("Falha ao carregar o Turnip selecionado. Use um driver ARM64 para Android.\n", stderr);
+            return;
+        }
+    } else {
+        handle = dlopen("libvulkan.so", RTLD_NOW | RTLD_LOCAL);
+        if (!handle) {
+            fprintf(stderr, "Vulkan do sistema indisponível: %s\n", dlerror());
+            return;
+        }
+    }
+    loader = (PFN_vkGetInstanceProcAddr)dlsym(handle, "vkGetInstanceProcAddr");
+    if (!loader) fputs("O driver não fornece vkGetInstanceProcAddr.\n", stderr);
+}
+
+PFN_vkGetInstanceProcAddr piston_android_vulkan_loader(void) {
+    pthread_once(&loader_once, init_loader);
+    return loader;
+}
+
+int piston_android_vulkan_device(VkInstance instance, VkPhysicalDevice device) {
+    PFN_vkGetInstanceProcAddr get = piston_android_vulkan_loader();
+    PFN_vkGetPhysicalDeviceProperties props_fn =
+        (PFN_vkGetPhysicalDeviceProperties)get(instance, "vkGetPhysicalDeviceProperties");
+    if (!props_fn) return 1;
+    VkPhysicalDeviceProperties props;
+    props_fn(device, &props);
+    printf("GPU: %s | Vulkan %u.%u.%u\n", props.deviceName,
+           VK_API_VERSION_MAJOR(props.apiVersion), VK_API_VERSION_MINOR(props.apiVersion),
+           VK_API_VERSION_PATCH(props.apiVersion));
+    if (props.apiVersion < VK_API_VERSION_1_3) {
+        fputs("O jogo exige Vulkan 1.3 no dispositivo. Selecione um Turnip compatível.\n", stderr);
+        return 1;
+    }
+
+    PFN_vkGetPhysicalDeviceProperties2 props2_fn =
+        (PFN_vkGetPhysicalDeviceProperties2)get(instance, "vkGetPhysicalDeviceProperties2");
+    if (!props2_fn) return 1;
+    VkPhysicalDeviceDriverProperties driver = {
+        .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES,
+    };
+    VkPhysicalDeviceProperties2 queried = {
+        .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,
+        .pNext = &driver,
+    };
+    props2_fn(device, &queried);
+    printf("Driver: %s (%s)\n", driver.driverName, driver.driverInfo);
+    if (getenv("PISTON_TURNIP_DIR") && driver.driverID != VK_DRIVER_ID_MESA_TURNIP) {
+        fputs("O driver ativo não é Mesa Turnip. O driver selecionado não pôde ser ativado.\n", stderr);
+        return 1;
+    }
+    return 0;
+}
+
+static int check_extensions(PFN_vkGetInstanceProcAddr get, VkInstance instance, VkPhysicalDevice device) {
+    PFN_vkEnumerateDeviceExtensionProperties enumerate =
+        (PFN_vkEnumerateDeviceExtensionProperties)get(instance, "vkEnumerateDeviceExtensionProperties");
+    uint32_t count = 0;
+    if (!enumerate || enumerate(device, NULL, &count, NULL) != VK_SUCCESS || !count) return 1;
+    VkExtensionProperties *extensions = calloc(count, sizeof(*extensions));
+    if (!extensions) return 1;
+    int failed = enumerate(device, NULL, &count, extensions) != VK_SUCCESS;
+    if (!failed) {
+        const char *const required[] = {
+            VK_KHR_SWAPCHAIN_EXTENSION_NAME, VK_KHR_PUSH_DESCRIPTOR_EXTENSION_NAME,
+            VK_EXT_VERTEX_ATTRIBUTE_DIVISOR_EXTENSION_NAME, VK_EXT_ROBUSTNESS_2_EXTENSION_NAME,
+        };
+        for (size_t i = 0; i < sizeof(required) / sizeof(required[0]); ++i) {
+            uint32_t j = 0;
+            while (j < count && strcmp(extensions[j].extensionName, required[i])) ++j;
+            if (j == count) {
+                fprintf(stderr, "Extensão exigida ausente: %s\n", required[i]);
+                failed = 1;
+            }
+        }
+    }
+    free(extensions);
+    return failed;
+}
+
+int piston_android_vulkan_test(void) {
+    PFN_vkGetInstanceProcAddr get = piston_android_vulkan_loader();
+    if (!get) return 1;
+    PFN_vkEnumerateInstanceVersion version =
+        (PFN_vkEnumerateInstanceVersion)get(VK_NULL_HANDLE, "vkEnumerateInstanceVersion");
+    uint32_t api = VK_API_VERSION_1_0;
+    if (version && version(&api) != VK_SUCCESS) return 1;
+    if (api < VK_API_VERSION_1_3) {
+        fprintf(stderr, "O carregador oferece Vulkan %u.%u. O jogo exige Vulkan 1.3.\n",
+            VK_API_VERSION_MAJOR(api), VK_API_VERSION_MINOR(api));
+        return 1;
+    }
+    PFN_vkCreateInstance create = (PFN_vkCreateInstance)get(VK_NULL_HANDLE, "vkCreateInstance");
+    const VkApplicationInfo app = {
+        .sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+        .pApplicationName = "PistonPort", .apiVersion = VK_API_VERSION_1_3,
+    };
+    const VkInstanceCreateInfo info = {
+        .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO, .pApplicationInfo = &app,
+    };
+    VkInstance instance;
+    if (!create || create(&info, NULL, &instance) != VK_SUCCESS) {
+        fputs("Falha ao criar uma instância Vulkan 1.3.\n", stderr);
+        return 1;
+    }
+    PFN_vkDestroyInstance destroy = (PFN_vkDestroyInstance)get(instance, "vkDestroyInstance");
+    PFN_vkEnumeratePhysicalDevices enumerate =
+        (PFN_vkEnumeratePhysicalDevices)get(instance, "vkEnumeratePhysicalDevices");
+    uint32_t count = 0;
+    int passed = 0;
+    if (enumerate && enumerate(instance, &count, NULL) == VK_SUCCESS && count) {
+        VkPhysicalDevice *devices = calloc(count, sizeof(*devices));
+        if (devices && enumerate(instance, &count, devices) == VK_SUCCESS) {
+            for (uint32_t i = 0; i < count && !passed; ++i)
+                passed = !piston_android_vulkan_device(instance, devices[i]) &&
+                         !check_extensions(get, instance, devices[i]);
+        }
+        free(devices);
+    }
+    if (destroy) destroy(instance, NULL);
+    puts(passed ? "Vulkan 1.3 e extensões exigidas: OK." :
+                  "Nenhum dispositivo Vulkan compatível foi encontrado.");
+    return !passed;
+}
